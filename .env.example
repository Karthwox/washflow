# Copy this file to .env and fill it in. Never commit .env.

# Operator (staff) access key: at least 12 characters, random and private.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
OPERATOR_ACCESS_KEY=

# Port for the API server.
PORT=3000

# Comma-separated list of the portal origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Allows the operator's "reset database" button. Demo use only: keep false for real data.
ALLOW_DEMO_RESET=false

# Where the API keeps its data (relative to this folder, or an absolute path).
DATA_FILE=database.json

# Frontend: where the portals find the API (read by Vite at build time).
VITE_API_URL=http://localhost:3000
